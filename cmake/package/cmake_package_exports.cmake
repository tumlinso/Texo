include(CMakeFindDependencyMacro)
set(Texo_VERSION "${PROJECT_VERSION}")
set(Texo_IR_FORMAT_MAJOR 2)
set(Texo_PROFILE_FORMAT_MAJOR 2)
set(Texo_HAS_COMPILER TRUE)
set(Texo_HAS_RUNTIME TRUE)
set(Texo_HAS_CUDA_BACKEND TRUE)
set(_texo_components Compiler Runtime BackendCUDA ProviderSDK)
foreach(_component IN LISTS _texo_components)
  if(NOT TARGET Texo::${_component})
    add_library(Texo::${_component} INTERFACE IMPORTED)
  endif()
endforeach()
unset(_texo_components)
