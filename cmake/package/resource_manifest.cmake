function(texo_write_resource_manifest output root)
  file(GLOB_RECURSE _files RELATIVE "${root}" "${root}/*")
  list(SORT _files)
  file(WRITE "${output}" "format=texo-resource-manifest-v2\ntexo_ir=2\nprofile=2\nschema=2\n")
  foreach(_path IN LISTS _files)
    if(NOT IS_DIRECTORY "${root}/${_path}")
      file(SHA256 "${root}/${_path}" _sha256)
      file(APPEND "${output}" "${_sha256}  ${_path}\n")
    endif()
  endforeach()
endfunction()
